rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'customerName', 'shippingAddress', 'paymentMethod', 'total', 'status']) &&
             data.keys().hasOnly(['userId', 'customerName', 'customerEmail', 'shippingAddress', 'paymentMethod', 'subtotal', 'shippingFee', 'total', 'status', 'itemCount', 'items', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.shippingAddress is string && data.shippingAddress.size() <= 500 &&
             data.paymentMethod in ['upi', 'card', 'netbanking', 'cod'] &&
             data.total is number && data.total >= 0 &&
             data.status in ['placed', 'processing', 'shipped', 'delivered'];
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productId']) &&
             data.keys().hasOnly(['userId', 'productId', 'productName', 'price', 'addedAt']) &&
             data.userId == request.auth.uid &&
             data.productId is string && data.productId.size() <= 64;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email']) &&
             data.keys().hasOnly(['email', 'subscribedAt']) &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 256;
    }

    // User collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming());
      allow update: if false; // Orders are immutable from client after placement
      allow delete: if false;
    }

    // Wishlist collection
    match /wishlists/{wishlistId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(wishlistId) && isSignedIn() && isValidWishlist(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Newsletter collection
    match /newsletter/{subscriberId} {
      allow get: if false;
      allow list: if false;
      allow create: if isValidId(subscriberId) && isValidNewsletter(incoming());
      allow update, delete: if false;
    }
  }
}
